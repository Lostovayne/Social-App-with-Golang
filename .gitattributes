# Auto detect text files and perform LF normalization
* text=auto

# Scripts y configs: siempre LF (ejecutables en CI/CD, containers, etc.)
*.sh      text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
justfile  text eol=lf
justfile* text eol=lf
.env*     text eol=lf

# Go: siempre LF
*.go      text eol=lf

# Binarios: nunca tocar
*.exe     binary
*.dll     binary
*.so      binary
*.dylib   binary