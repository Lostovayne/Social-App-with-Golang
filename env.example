# Plantilla de variables de entorno para direnv
#
# Setup:
#   1. Copia este archivo a .envrc en la raiz del proyecto:
#        cp env.example .envrc
#   2. Instala direnv: https://direnv.net/docs/installation.html
#   3. Permite direnv en este directorio:
#        direnv allow
#
# Las variables se exportan al shell y las heredan `make`, `go run`, etc.
# .envrc no se commitea (esta en .gitignore); env.example si.

export ADDR=":8080"
export DB_ADDR="postgres://admin:adminpassword@localhost:5432/social?sslmode=disable"
export ENV="development"
export DB_MAX_OPEN_CONNS="30"
export DB_MAX_IDLE_CONNS="30"
export DB_MAX_IDLE_TIME="15m"
