# Plantilla para activar el entorno de desarrollo con devenv + direnv
#
# Setup:
#   1. Instala Nix y devenv:
#        https://devenv.sh/getting-started/
#   2. Copia este archivo a .envrc:
#        cp env.example .envrc
#   3. Permite direnv:
#        direnv allow
#   4. Levanta servicios (Postgres + API con hot reload):
#        devenv up
#
# Variables de entorno (ADDR, DB_ADDR, etc.) se definen en devenv.nix.
# .envrc solo activa devenv; no commitees secretos aquí.

#!/usr/bin/env bash
eval "$(devenv direnvrc)"
use devenv
